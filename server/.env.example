# =============================================================================
# Multra-EU — environment template
# Copia este archivo a `.env` (dev) y configura las variables en Vercel
# dashboard (prod). NO commitees el `.env` real.
# =============================================================================

NODE_ENV=development
PORT=3001

# -----------------------------------------------------------------------------
# DB — Elegir UNO de los tres modos
# -----------------------------------------------------------------------------

# --- SQLite (dev local) ---
DB_TYPE=sqlite
SQLITE_PATH=./data/multra.db

# --- Postgres / Neon (prod Vercel) ---
# DB_TYPE=postgres
# DATABASE_URL=postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/multra?sslmode=require

# --- MySQL (self-host tradicional) ---
# DB_TYPE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=multra_app
# DB_PASS=***
# DB_NAME=multra

# -----------------------------------------------------------------------------
# Auth — JWT + bcrypt
# -----------------------------------------------------------------------------
# JWT_SECRET: mínimo 32 caracteres. Generar con:
#   node -e "console.log(crypto.randomBytes(64).toString('hex'))"
JWT_SECRET=REEMPLAZA_con_64_bytes_hex_minimo
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Admin user (seed inicial en DB vacía)
# -----------------------------------------------------------------------------
ADMIN_USER=multra_admin
ADMIN_PASS=2cLyT8JZaqpHfMSSS7KC

# -----------------------------------------------------------------------------
# CORS — En prod, listar los orígenes exactos (separados por coma).
# Vercel auto-asigna: https://<project>.vercel.app
# -----------------------------------------------------------------------------
CORS_ORIGINS=https://multra-eu.vercel.app

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# -----------------------------------------------------------------------------
# Frontend estático — solo relevante en dev (Vercel sirve public/ directo)
# -----------------------------------------------------------------------------
FRONTEND_DIR=../Multra-EU

# -----------------------------------------------------------------------------
# Seed demo — activar con MULTRA_SEED_DEMO=1 la primera vez (solo dev)
# -----------------------------------------------------------------------------
MULTRA_SEED_DEMO=0