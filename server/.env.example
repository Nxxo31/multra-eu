# ============================================================
# Multra E.U. — Variables de entorno (PLANTILLA)
# Copia este archivo a `.env` y rellena los secretos.
# NUNCA commitees `.env` al repositorio (está en .gitignore).
# ============================================================

# Entorno: 'development' | 'production' | 'test'
NODE_ENV=development
PORT=3001

# Base de datos: 'sqlite' (dev/test) o 'mysql' (producción)
DB_TYPE=sqlite
SQLITE_PATH=./data/multra.db

# MySQL (solo si DB_TYPE=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=multra_app
DB_PASS=
DB_NAME=multra

# Seguridad — ROTO y regenerado el 2026-09-19.
# Genera uno nuevo con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# CORS — orígenes separados por coma. * solo en dev local.
CORS_ORIGINS=http://localhost:3001,http://localhost:5500,http://127.0.0.1:5500

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Credenciales del admin seed (se crean al primer arranque si users está vacío).
# Genera un password fuerte: node -e "console.log(require('crypto').randomBytes(20).toString('base64url'))"
ADMIN_USER=
ADMIN_PASS=

# Seed demo opt-in (clientes Carlos/Laura/Andrés + 3 vehículos + 3 pólizas + 2 citas + 1 trámite + 2 pagos).
# Vacío o ausente = NO siembra datos demo. Solo servicios + admin.
# MULTRA_SEED_DEMO=1   <- descomentar para datos de prueba en dev
MULTRA_SEED_DEMO=

# Frontend estático (ruta relativa al directorio server/)
FRONTEND_DIR=Multra-EU
